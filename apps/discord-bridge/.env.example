# Written by `bun run dev:setup`. The bridge only runs when all three are set.
# Bot token from https://discord.com/developers/applications → your app → Bot.
DISCORD_BOT_TOKEN=
# Same value as BRIDGE_SHARED_SECRET in the Convex deployment environment.
BRIDGE_SHARED_SECRET=
# Your Convex deployment's HTTP actions URL (ends in .convex.site).
CONVEX_SITE_URL=
