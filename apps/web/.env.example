# Example only. `bun run dev:setup` writes the real values to apps/web/.env.local.
# Server secrets (API keys, auth secret) are never stored here; they live in the
# Convex deployment environment. See README "Environment".
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
NEXT_PUBLIC_SITE_URL=http://localhost:3001
