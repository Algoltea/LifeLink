# LifeLink web app environment. Values are written to .env.local by `bun run dev:setup`.
# Only public, non-secret values live here: every server secret is stored in the
# Convex deployment's environment, never in the browser bundle.
#
# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Convex deployment URL (ends in .convex.cloud, or a local URL for local deployments).
# @public @type=url(matches="^(?!https?://example[.]convex[.])")
NEXT_PUBLIC_CONVEX_URL=

# Convex HTTP actions URL (ends in .convex.site): auth routes, webhooks, photo delivery.
# @public @type=url(matches="^(?!https?://example[.]convex[.])")
NEXT_PUBLIC_CONVEX_SITE_URL=

# Where this web app is served. Must match SITE_URL in the Convex environment.
# @public @type=url
NEXT_PUBLIC_SITE_URL=http://localhost:3001
