# Convex deployment environment (server-side only). EXAMPLE, not read by anything.
# `bun run dev:setup` sets these with `convex env set NAME` (value on stdin).
# Never put real values in this file or in any committed file.
# Inspect the live values with: cd packages/backend && bunx convex env list --names-only

# ── Core (required) ──
# Better Auth secret. Generated by setup (32 random bytes, base64).
BETTER_AUTH_SECRET=
# Web app URL. Where the web app runs; Better Auth trusts this origin.
SITE_URL=http://localhost:3001
# Allow Practice mode. Allow people to choose Practice mode explicitly. Simulated outcomes are always labelled Practice.
DEMO_MODE_ALLOWED=true
# Bridge shared secret. Generated by setup; signs requests from the local Discord bridge.
BRIDGE_SHARED_SECRET=

# ── OpenRouter (optional) ── Conversation, drafting, summaries, scam explanations, and structured action proposals.
# Console: https://openrouter.ai/settings/keys
# OpenRouter API key. Starts with sk-or-.
OPENROUTER_API_KEY=
# Main Gemini model on OpenRouter. Model for conversations, drafts, summaries, and action proposals.
OPENROUTER_MODEL=google/gemini-4-argon
# Fast model on OpenRouter. Cheaper model for short classification jobs such as reading a reply.
OPENROUTER_FAST_MODEL=z-ai/glm-5.3-flash
# ElevenLabs read-aloud through the OpenRouter key above.
OPENROUTER_TTS_MODEL=elevenlabs/eleven-v4-turbo
# Default read-aloud voice; a person's saved Settings voice overrides it.
OPENROUTER_TTS_VOICE=sarah

# ── Gemini Live (voice) (optional) ── Two-way spoken conversation with captions. Voice requests go through the same review and approval as typed ones.
# Console: https://aistudio.google.com/apikey
# Gemini API key. Long-lived key; stays in Convex.
GEMINI_API_KEY=
# Gemini Live model. Live API model used for spoken conversation.
GEMINI_LIVE_MODEL=gemini-3.8-live

# ── Composio (optional) ── Gmail, Outlook, Google Calendar, PayPal, Facebook, Instagram, and eBay through each person's own connected account.
# Console: https://platform.composio.dev
# Composio API key. Project API key.
COMPOSIO_API_KEY=
# Composio webhook signing secret (optional). Created by setup when it registers the webhook; or copy it from the dashboard.
COMPOSIO_WEBHOOK_SECRET=
# Composio auth configs (optional). JSON map of toolkit to auth config id, written by setup.
COMPOSIO_AUTH_CONFIGS=

# ── Photon Spectrum Stable (optional) ── Link existing shared-line users in Trusted circle.
# Console: https://photon.codes
# Spectrum project secret; used with the project ID for Basic authentication.
SPECTRUM_PROJECT_SECRET=
# Spectrum project ID (UUID), from your existing Photon dashboard project.
SPECTRUM_PROJECT_ID=
# Spectrum webhook signing secret (optional), written by setup.
SPECTRUM_WEBHOOK_SECRET=
# Choose "Set up iMessage" per contact; they must text their assigned number first.
# No Photon account or dashboard teammate invitation is needed for contacts.
# Keep existing dashboard registrations. New people must first be added in Photon.
# LifeLink does not create registrations or send invitations. Practice mode never contacts Spectrum.

# ── Discord (optional) ── Message family members who use Discord, and receive their replies.
# Console: https://discord.com/developers/applications
# Discord bot token. Bot token from the Bot tab.
DISCORD_BOT_TOKEN=
# Discord application id. Application ID from General Information.
DISCORD_APPLICATION_ID=
# Discord public key (optional). Public Key from General Information.
DISCORD_PUBLIC_KEY=
