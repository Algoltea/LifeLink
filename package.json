{
  "name": "lifelink",
  "private": true,
  "description": "LifeLink: an accessible assistant that helps older adults stay connected, manage everyday tasks, and assess suspicious messages.",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "@types/node": "^26.4.1",
      "varlock": "1.18.0",
      "lucide-react": "^1.41.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.8",
      "convex": "^1.47.0",
      "better-auth": "1.6.17",
      "@convex-dev/better-auth": "^0.12.5",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.7",
      "tailwindcss": "^4.3.3",
      "vitest": "^5.0.5",
      "convex-test": "^0.0.62",
      "@edge-runtime/vm": "^5.0.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:setup": "bun ./scripts/setup/main.ts",
    "demo:create": "bun ./scripts/setup/demo-account.ts",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F @lifelink/backend --",
    "build": "turbo run build",
    "check-types": "turbo run check-types && tsc --noEmit -p scripts",
    "test": "turbo run test && vitest run scripts",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "env:generate": "varlock codegen --path ./apps/web/",
    "postinstall": "varlock codegen --path ./apps/web/"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@lifelink/config": "workspace:*",
    "@oxlint/plugins": "1.88.0",
    "@types/node": "catalog:",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.71.0",
    "oxlint": "1.88.0",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "ultracite": "8.0.0",
    "varlock": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "@next/env": "npm:@varlock/nextjs-integration@1.2.2"
  },
  "packageManager": "bun@1.4.4"
}
